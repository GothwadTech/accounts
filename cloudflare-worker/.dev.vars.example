# =============================================================================
# LOCAL DEVELOPMENT SECRETS (`cloudflare-worker/.dev.vars`)
# =============================================================================
# Usage:
#   cp .dev.vars.example .dev.vars
#   npx wrangler dev
#
# NOTE: `.dev.vars` is gitignored — NEVER commit real secrets to Git!
# Supabase keys are NO LONGER NEEDED — local D1 runs natively inside Wrangler!
# =============================================================================

DEV_MODE="true"
JWT_SECRET="local-dev-only-jwt-secret-change-in-production-0123456789"
MAIL_INTERNAL_TOKEN="local-dev-mail-internal-token"
# RESEND_API_KEY="re_xxxxxxxxx"
