# =============================================================================
# GOTHWAD ACCOUNTS — ENVIRONMENT VARIABLES REFERENCE (100% CLOUDFLARE NATIVE)
# =============================================================================
# Production config lives in:
#   1. Public vars & D1 binding -> `cloudflare-worker/wrangler.toml`
#   2. Worker secrets           -> Cloudflare Dashboard -> Workers & Pages -> `accounts` -> Variables and Secrets
#   3. Frontend public config   -> `web/js/config.js`
# =============================================================================

# Public runtime config (also in `cloudflare-worker/wrangler.toml`)
APP_DOMAIN=gothwadtech.com
AUTH_HUB_URL=https://accounts.gothwadtech.com
API_DOMAIN=api.gothwadtech.com
RESEND_FROM="Gothwad Accounts <onboarding@resend.dev>"
DEV_MODE=false

# Secrets (NEVER commit real values — set as Secret in Cloudflare Dashboard)
JWT_SECRET=replace-with-strong-48-char-random-string
MAIL_INTERNAL_TOKEN=replace-with-shared-secret-matching-mail-worker
RESEND_API_KEY=re_optional_for_password_reset_emails
