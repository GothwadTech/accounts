# =============================================================================
# GOTHWAD ACCOUNTS — ENVIRONMENT VARIABLES (Complete List)
# =============================================================================
# Yeh file "reference list" hai. Inhe 2 jagah set karte hain:
#
#   1) CLOUDFLARE WORKER  →  cloudflare-worker/wrangler.toml  ([vars] section)
#      aur secrets ke liye:  npx wrangler secret put <NAME>
#
#   2) FRONTEND           →  web/js/config.js  (sirf 2 values: API_URL, APP_DOMAIN)
#
# NOTE: Frontend ko "env file" ki zaroorat nahi — static site hai.
#       Local dev ke liye cloudflare-worker/.dev.vars bana sakte ho
#       (example: cloudflare-worker/.dev.vars.example dekho).
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# CORE (required)
# ─────────────────────────────────────────────────────────────────────────────

# Root domain — kahin bhi domain hardcode nahi hota (Rule #1).
# Email automatically banta hai: username + "@" + APP_DOMAIN
APP_DOMAIN=gothwadtech.com

# Frontend ka public URL (password-reset redirect ke liye)
AUTH_HUB_URL=https://accounts.gothwadtech.com

# Supabase project URL  (Supabase Dashboard → Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase anon/public key (safe for public use, Worker isse user-auth calls mein use karta hai)
SUPABASE_ANON_KEY=

# Supabase service_role key ⚠️ SECRET — sirf Worker, kabhi frontend/Git mein nahi!
SUPABASE_SERVICE_ROLE_KEY=

# JWT signing secret ⚠️ SECRET — OAuth access tokens (Step 2) sign karne ke liye
# Banao:  openssl rand -hex 32
JWT_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# EMAIL (optional abhi — password reset emails ke liye)
# ─────────────────────────────────────────────────────────────────────────────

# Resend API key (https://resend.com — free: 3000 emails/month)
RESEND_API_KEY=

# Emails ka "From" address (jab tak custom domain Resend mein verify nahi:
# Resend ka default "onboarding@resend.dev" use karo)
RESEND_FROM=Gothwad Accounts <onboarding@resend.dev>


# ─────────────────────────────────────────────────────────────────────────────
# DEV / SAFETY SWITCHES
# ─────────────────────────────────────────────────────────────────────────────

# "true"  = reset link API response mein bhi milta hai (dev/testing, jab Resend na ho)
# "false" = production mode (reset link sirf email par)
# ⚠️ LIVE hone se PEHLE false zaroor karna!
DEV_MODE=true

# Extra CORS origins, comma separated (sirf zaroorat par)
# Example: ALLOWED_ORIGINS=http://localhost:3000,https://preview.example.com
ALLOWED_ORIGINS=
